# Telegram / deployment
BOT_TOKEN=
WEBHOOK_URL=https://your-domain.example/webhook
WEBHOOK_SECRET=
PORT=8080

# Instagram downloader session (legacy bot-side authentication)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSIONID=
INSTAGRAM_AUTO_LOGIN=true
INSTAGRAM_COOKIE_REFRESH_HOURS=168

# Official Instagram Business Login / Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic
# Must exactly match the Redirect URI configured in Meta.
INSTAGRAM_REDIRECT_URI=https://your-domain.example/instagram/callback
# Telegram Mini App URL. If omitted, it is derived from WEBHOOK_URL.
MINIAPP_URL=https://your-domain.example/miniapp
